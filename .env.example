# Database (Neon Postgres with pgvector)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# A separate scratch database for pipeline tests. Schema must match schema.prisma.
# Easiest: a Neon branch. Locally, a Docker `pgvector/pgvector` instance.
TEST_POSTGRES_URL=

# Auth (cowpunk-auth)
SESSION_SECRET=

# Mail (login codes)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_URL=

# LLMs
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Inngest
INNGEST_EVENT_KEY=

# Vercel KV (chat data caching)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Mode flags
NODE_ENV=development

# When `true`, the chat route uses the legacy hosted OpenAI Assistant.
# When `false` (recommended), it uses the in-repo articulation prompt + chat completions,
# which lets the simulation harness drive the same code path.
USE_OPENAI_ASSISTANT=false

# Models. gpt-5 only supports temperature=1; the code sends `reasoning_effort`
# instead. To use a non-reasoning model (e.g. for cheaper iteration), set these
# to gpt-4.1 or gpt-4o.
OPENAI_ARTICULATION_MODEL=gpt-5
SIMULATION_MODEL=gpt-5
JUDGE_MODEL=gpt-5
VALUES_TOOLS_MODEL=gpt-5

# Pipeline tests cost OpenAI credits. Set to `1` to enable.
RUN_PIPELINE=
