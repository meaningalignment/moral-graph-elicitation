{
  "name": "mge",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "prisma generate && remix vite:build",
    "dev": "remix vite:dev",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:pipeline": "RUN_PIPELINE=1 vitest run tests/pipeline",
    "inngest": "npx inngest-cli@latest dev -u \"http://localhost:5173/api/inngest\" --port 8288 --no-discovery",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "lint-fix": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint . --fix",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "backup-sql": "DATE=`date +%Y-%m-%d_%H-%M-%S` && pg_dump $POSTGRES_URL > backups/backup-$DATE.sql",
    "backup": "DATE=`date +%Y-%m-%d_%H-%M-%S` && pg_dump -Fc $POSTGRES_URL > backups/backup-$DATE.dump",
    "db-diff": "prisma migrate diff --from-schema-datasource ./schema.prisma --to-schema-datamodel ./schema.prisma",
    "db": "tsx scripts/db.ts",
    "simulate": "tsx scripts/simulate.ts",
    "seed": "tsx scripts/seed-deliberation.ts",
    "dedup:dryrun": "tsx tests/pipeline/dedup-dryrun.fixture.ts",
    "fixtures:dedup": "tsx scripts/build-dedup-fixture.ts",
    "fixtures:transitions": "tsx scripts/build-transitions-fixture.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.76",
